{
  "name": "volt-vroom-operating-system",
  "version": "1.0.0-rc.2-otap",
  "private": true,
  "packageManager": "npm@10.9.4",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "check": "npm run repo:guard && npm run agent:audit && npm run typecheck && npm run test && npm run build",
    "check:ci": "npm run check",
    "repo:guard": "node scripts/repo-guard.mjs",
    "seed:demo": "node scripts/seed-demo.mjs",
    "clean": "rm -rf .next",
    "agent:audit": "node scripts/agent-audit.mjs",
    "test": "vitest run --configLoader runner",
    "test:watch": "vitest --configLoader runner",
    "readiness": "node scripts/production-readiness.mjs",
    "validate:env": "node scripts/validate-vv-environment.mjs"
  },
  "dependencies": {
    "firebase": "^12.0.0",
    "firebase-admin": "^13.0.0",
    "next": "^15.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "typescript": "^5.8.0",
    "vitest": "^3.2.4"
  },
  "overrides": {
    "postcss": "^8.5.18",
    "sharp": "^0.35.0"
  },
  "description": "VVOS - het digitale bedrijfsplatform van Volt & Vroom voor website, voorraad, CRM, sales, aflevering, werkplaats en finance."
}
