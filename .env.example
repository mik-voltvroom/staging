# Safe defaults. Local demo mode must be enabled deliberately by a developer.
VVOS_ENV=staging
NEXT_PUBLIC_SITE_URL=https://staging.voltvroom.nl
VVOS_DATA_MODE=firebase
VVOS_REQUIRE_AUTH=true

NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
FIREBASE_ADMIN_PROJECT_ID=
FIREBASE_ADMIN_CLIENT_EMAIL=
FIREBASE_ADMIN_PRIVATE_KEY=

RDW_API_BASE_URL=
RDW_API_KEY=
VWE_WEBHOOK_SECRET=

# Mobilox pushes the Hexon Eigen Website Incrementeel XML feed to VVOS.
# Generate dedicated staging-only HTTP Basic credentials; never reuse the
# Mobilox or Hexon portal login here.
HEXON_SYNC_USERNAME= Volt1
HEXON_SYNC_PASSWORD= Volt1

# Server-side only. Used by VVOS Photo Studio to remove only the source background.
# Never expose this as a NEXT_PUBLIC_ variable.
REMOVE_BG_API_KEY=

GOOGLE_MERCHANT_ID=
GOOGLE_MERCHANT_DATASOURCE=
GOOGLE_SERVICE_ACCOUNT_JSON=

WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
CRON_SECRET=

EMAIL_API_URL=
EMAIL_API_KEY=
WHATSAPP_API_URL=
WHATSAPP_TOKEN=
SALES_DEFAULT_OWNER=mik@voltvroom.nl

MOLLIE_API_KEY=
STRIPE_SECRET_KEY=
ESIGN_API_URL=
ESIGN_API_KEY=
PORTAL_TOKEN_SECRET=

AUDIT_HASH_SALT=
RDW_HEALTH_URL=
VWE_HEALTH_URL=
WHATSAPP_HEALTH_URL=
EMAIL_HEALTH_URL=
